# Native Linux CDSI build: does not install or link SGX/Open Enclave runtimes.
# Server executes JVM directory logic and intentionally provides NO attestation.
FROM eclipse-temurin:25-jdk-jammy AS build
WORKDIR /build
COPY . .
RUN chmod +x ./mvnw && ./mvnw -B -Pnative-linux -DskipTests \
    package dependency:copy-dependencies \
    -DincludeScope=runtime -DoutputDirectory=target/runtime-libs

FROM eclipse-temurin:25-jre-jammy
WORKDIR /home/app
RUN groupadd --gid 10000 cds && useradd --uid 10000 --gid 10000 cds
COPY --from=build /build/target/classes /home/app/classes
COPY --from=build /build/target/runtime-libs /home/app/libs
ENV MICRONAUT_ENVIRONMENTS=native
EXPOSE 8080
USER 10000
ENTRYPOINT ["java","-cp","/home/app/libs/*:/home/app/classes","org.signal.cdsi.Application"]
